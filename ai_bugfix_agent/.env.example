# Key von https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional, Default: ~anthropic/claude-haiku-latest
# OPENROUTER_MODEL=
# Optional, Default: chat.txt neben package.json
# CHAT_FILE=
# Optional, Default: datei. Mit slack liest der Agent den Channel SLACK_CHANNEL_ID.
# CHAT_SOURCE=
# Bot-Token xoxb-… (OAuth & Permissions). Auch npm run steps nutzt ihn für Statusmeldungen.
# SLACK_BOT_TOKEN=
# App-Level-Token xapp-… mit Scope connections:write (Basic Information)
# SLACK_APP_TOKEN=
# Channel-ID von #bugs, beginnt mit C (Channel-Details, ganz unten)
# SLACK_CHANNEL_ID=

# --- Tickets ---
# Optional, Default: datei (tickets/bug_N.txt). Mit github werden Tickets Issues in GITHUB_REPO.
# TICKET_STORE=
# Fine-grained Token nur für GITHUB_REPO, Berechtigung "Issues: Read and write"
# GITHUB_TOKEN=
# owner/name, z. B. guidodunker/ai_experiments
# GITHUB_REPO=

# --- Stufe 2: npm run steps ---
# Ziel-Repo, absolut oder relativ zu diesem Verzeichnis. Muss ein Git-Repo sein.
TARGET_REPO=
# Optional, Default: main
# TARGET_BASE=
# Optional, Default: npm test
# TARGET_TEST_CMD=
# Optional, Default: openrouter. Wer die Sitzungen bezahlt:
#   openrouter    über OPENROUTER_API_KEY; der Claude-Code-Login wird nicht benutzt
#   claude-login  über ANTHROPIC_API_KEY oder, ohne Key, den Claude-Code-Login dieses Rechners
# STEPS_BACKEND=
# Optional, Default: anthropic/claude-opus-5 (openrouter) bzw. claude-opus-5 (claude-login)
# STEPS_MODEL=
# Optional, Default: 2 (US-Dollar je Sitzung)
# STEPS_MAX_BUDGET_USD=
# Nur bei STEPS_BACKEND=claude-login. Ohne Key nutzt das Agent SDK den Claude-Code-Login.
# ANTHROPIC_API_KEY=
# Für npm run demo:init, z. B. C:\workspace\tests\bugfix_demo
# DEMO_TARGET=
